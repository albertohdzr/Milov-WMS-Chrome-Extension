{
  "manifest_version": 3,
  "name": "Milov — Komodin Wave Enrichment",
  "version": "0.4.0",
  "description": "Enriquece Crear Wave y guarda la planeación de fecha, chofer y ruta en milov-app.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://milov-web-app.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://milov-wms.komodin.io/wave_new/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
